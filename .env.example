# OpenRouter API Key (Free tier model used: mistralai/mistral-small-3.1-24b-instruct:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gmail SMTP Configuration
# Use a Google App Password (not your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Single email or comma-separated list of multiple recipients:
EMAIL_RECIPIENTS=user1@gmail.com, user2@gmail.com

# Target French proficiency level (advanced by default)
FRENCH_LEVEL=advanced
